# ==============================================================================
# GymOS - Environment Configuration Template
# ==============================================================================
# Copy this file to .env for local development:
#   cp .env.example .env
#
# STRICT RULE: Never commit actual credentials, API keys, or production secrets.
# ==============================================================================

# Application Environment
NODE_ENV=development

# Frontend Application (apps/web)
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# Backend API Gateway (apps/api)
PORT=4000
API_PREFIX=api
CORS_ORIGIN=http://localhost:3000

# PostgreSQL Database (Shared Multi-Tenant)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL=postgresql://gymos_user:gymos_dev_password@localhost:5432/gymos_dev?schema=public
DATABASE_TEST_URL=postgresql://gymos_user:gymos_dev_password@localhost:5432/gymos_test?schema=public

# Redis & BullMQ Queues (apps/api, apps/worker)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Background Worker Settings (apps/worker)
WORKER_CONCURRENCY=5

# Authentication & Security
# Minimum 16 characters for development. In production use 64+ char random string.
JWT_SECRET=development-gymos-super-secret-jwt-key-replace-in-prod
JWT_REFRESH_SECRET=development-gymos-super-secret-refresh-key-replace-in-prod
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
COOKIE_SECRET=development-gymos-super-secret-cookie-key-replace-in-prod
COOKIE_SAME_SITE=lax
COOKIE_DOMAIN=

# Structured Logging (apps/api, apps/worker)
# Allowed: error, warn, info, debug
LOG_LEVEL=info

# Object Storage Configuration (Placeholders for future stages)
STORAGE_DRIVER=local
STORAGE_S3_BUCKET=gymos-tenant-assets
STORAGE_S3_REGION=us-east-1
STORAGE_S3_ACCESS_KEY=
STORAGE_S3_SECRET_KEY=

# Notification Providers (Placeholders for future stages)
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
