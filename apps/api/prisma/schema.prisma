// GymOS Multi-Tenant PostgreSQL Schema
// Stage 2.2 Authentication & RBAC

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
  TRIAL
  CANCELLED

  @@map("tenant_status")
}

enum BranchStatus {
  ACTIVE
  INACTIVE
  CLOSED

  @@map("branch_status")
}

enum AssignmentStatus {
  ACTIVE
  INACTIVE

  @@map("assignment_status")
}

enum UserRole {
  GYM_OWNER
  GYM_ADMIN
  RECEPTIONIST
  TRAINER
  MEMBER

  @@map("user_role")
}

enum UserStatus {
  ACTIVE
  INACTIVE
  PENDING_VERIFICATION
  SUSPENDED

  @@map("user_status")
}

enum MemberStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  ARCHIVED

  @@map("member_status")
}

enum Gender {
  MALE
  FEMALE
  OTHER
  PREFER_NOT_TO_SAY

  @@map("gender")
}

enum PlanDurationType {
  DAYS
  MONTHS
  YEARS

  @@map("plan_duration_type")
}

enum PlanScope {
  SINGLE_BRANCH
  MULTI_BRANCH
  ALL_BRANCHES

  @@map("plan_scope")
}

enum PlanStatus {
  ACTIVE
  INACTIVE
  ARCHIVED

  @@map("plan_status")
}

enum MembershipStatus {
  PENDING
  ACTIVE
  FROZEN
  EXPIRED
  CANCELLED
  TERMINATED

  @@map("membership_status")
}

enum FreezeStatus {
  ACTIVE
  COMPLETED
  CANCELLED

  @@map("freeze_status")
}

enum OutboxStatus {
  PENDING
  PROCESSING
  PUBLISHED
  FAILED

  @@map("outbox_status")
}

/// Organization represents an isolated Gym Tenant in GymOS
model Organization {
  id                      String                    @id @default(uuid()) @map("id") @db.Uuid
  name                    String                    @map("name") @db.VarChar(255)
  slug                    String                    @unique @map("slug") @db.VarChar(100)
  legalName               String?                   @map("legal_name") @db.VarChar(255)
  businessEmail           String?                   @map("business_email") @db.VarChar(255)
  businessPhone           String?                   @map("business_phone") @db.VarChar(50)
  website                 String?                   @map("website") @db.VarChar(255)
  logoUrl                 String?                   @map("logo_url") @db.VarChar(500)
  description             String?                   @map("description") @db.Text
  addressLine1            String?                   @map("address_line_1") @db.VarChar(255)
  addressLine2            String?                   @map("address_line_2") @db.VarChar(255)
  city                    String?                   @map("city") @db.VarChar(100)
  state                   String?                   @map("state") @db.VarChar(100)
  country                 String?                   @map("country") @db.VarChar(100)
  postalCode              String?                   @map("postal_code") @db.VarChar(20)
  timezone                String                    @default("UTC") @map("timezone") @db.VarChar(50)
  currency                String                    @default("INR") @map("currency") @db.VarChar(10)
  status                  TenantStatus              @default(ACTIVE) @map("status")
  createdAt               DateTime                  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt               DateTime                  @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  memberships             OrganizationUser[]
  branches                Branch[]
  branchStaffAssignments  BranchStaffAssignment[]
  auditLogs               AuditLog[]
  members                 Member[]
  memberTransfers         MemberTransfer[]
  memberSequence          OrganizationMemberSequence?
  membershipPlans         MembershipPlan[]
  membershipPlanBranches  MembershipPlanBranch[]
  memberSubscriptions     MemberMembership[]
  membershipFreezes       MembershipFreeze[]
  membershipHistories     MembershipHistory[]
  membershipOutboxEvents  MembershipOutboxEvent[]

  @@map("organizations")
}

/// Global User identity across the platform
model User {
  id                      String                   @id @default(uuid()) @map("id") @db.Uuid
  email                   String                   @unique @map("email") @db.VarChar(255)
  passwordHash            String                   @map("password_hash") @db.VarChar(255)
  firstName               String                   @map("first_name") @db.VarChar(100)
  lastName                String                   @map("last_name") @db.VarChar(100)
  isSuperAdmin            Boolean                  @default(false) @map("is_super_admin")
  status                  UserStatus               @default(ACTIVE) @map("status")
  emailVerified           Boolean                  @default(false) @map("email_verified")
  emailVerifiedAt         DateTime?                @map("email_verified_at") @db.Timestamptz
  lastLoginAt             DateTime?                @map("last_login_at") @db.Timestamptz
  createdAt               DateTime                 @default(now()) @map("created_at") @db.Timestamptz
  updatedAt               DateTime                 @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  memberships             OrganizationUser[]
  auditLogs               AuditLog[]
  refreshTokens           RefreshToken[]
  passwordResetTokens     PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
  members                 Member[]

  @@map("users")
}

/// Association between Users and Organizations with assigned Role
model OrganizationUser {
  id                      String                  @id @default(uuid()) @map("id") @db.Uuid
  organizationId          String                  @map("organization_id") @db.Uuid
  userId                  String                  @map("user_id") @db.Uuid
  role                    UserRole                @default(MEMBER) @map("role")
  createdAt               DateTime                @default(now()) @map("created_at") @db.Timestamptz

  // Foreign keys
  organization            Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user                    User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  branchStaffAssignments  BranchStaffAssignment[]

  @@unique([organizationId, userId], name: "unique_org_user")
  @@index([organizationId], map: "idx_org_user_org_id")
  @@index([userId], map: "idx_org_user_user_id")
  @@index([organizationId, id], map: "idx_org_users_org_composite")
  @@map("organization_users")
}

/// Physical gym location belonging strictly to an Organization
model Branch {
  id               String                  @id @default(uuid()) @map("id") @db.Uuid
  organizationId   String                  @map("organization_id") @db.Uuid
  name             String                  @map("name") @db.VarChar(255)
  slug             String                  @map("slug") @db.VarChar(100)
  branchCode       String                  @map("branch_code") @db.VarChar(50)
  description      String?                 @map("description") @db.Text
  email            String?                 @map("email") @db.VarChar(255)
  phone            String?                 @map("phone") @db.VarChar(50)
  website          String?                 @map("website") @db.VarChar(255)
  logoUrl          String?                 @map("logo_url") @db.VarChar(500)
  addressLine1     String?                 @map("address_line_1") @db.VarChar(255)
  addressLine2     String?                 @map("address_line_2") @db.VarChar(255)
  city             String?                 @map("city") @db.VarChar(100)
  state            String?                 @map("state") @db.VarChar(100)
  country          String?                 @map("country") @db.VarChar(100)
  postalCode       String?                 @map("postal_code") @db.VarChar(20)
  timezone         String                  @default("UTC") @map("timezone") @db.VarChar(50)
  status           BranchStatus            @default(ACTIVE) @map("status")
  createdAt        DateTime                @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime                @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  organization     Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  staffAssignments BranchStaffAssignment[]
  members          Member[]
  transfersFrom    MemberTransfer[]        @relation("TransferFromBranch")
  transfersTo      MemberTransfer[]        @relation("TransferToBranch")
  planBranches     MembershipPlanBranch[]
  homeMemberships  MemberMembership[]

  @@unique([organizationId, slug], name: "unique_org_branch_slug")
  @@unique([organizationId, branchCode], name: "unique_org_branch_code")
  @@index([organizationId], map: "idx_branches_org_id")
  @@index([status], map: "idx_branches_status")
  @@index([organizationId, id], map: "idx_branches_org_composite")
  @@map("branches")
}

/// Assignment of organization staff member to a specific physical branch
model BranchStaffAssignment {
  id                 String            @id @default(uuid()) @map("id") @db.Uuid
  organizationId     String            @map("organization_id") @db.Uuid
  branchId           String            @map("branch_id") @db.Uuid
  organizationUserId String            @map("organization_user_id") @db.Uuid
  status             AssignmentStatus  @default(ACTIVE) @map("status")
  assignedAt         DateTime          @default(now()) @map("assigned_at") @db.Timestamptz
  assignedBy         String?           @map("assigned_by") @db.Uuid
  createdAt          DateTime          @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime          @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  organization       Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch             Branch            @relation(fields: [branchId], references: [id], onDelete: Cascade)
  organizationUser   OrganizationUser  @relation(fields: [organizationUserId], references: [id], onDelete: Cascade)

  @@unique([branchId, organizationUserId], name: "unique_branch_org_user")
  @@index([organizationId], map: "idx_branch_staff_org_id")
  @@index([branchId], map: "idx_branch_staff_branch_id")
  @@index([organizationUserId], map: "idx_branch_staff_org_user_id")
  @@index([organizationId, id], map: "idx_branch_staff_org_composite")
  @@map("branch_staff_assignments")
}

/// Comprehensive Immutable Tenant Audit Log
model AuditLog {
  id             String        @id @default(uuid()) @map("id") @db.Uuid
  organizationId String?       @map("organization_id") @db.Uuid
  userId         String?       @map("user_id") @db.Uuid
  action         String        @map("action") @db.VarChar(100)
  entity         String        @map("entity") @db.VarChar(100)
  entityId       String?       @map("entity_id") @db.VarChar(100)
  metadata       Json?         @map("metadata")
  ipAddress      String?       @map("ip_address") @db.VarChar(45)
  userAgent      String?       @map("user_agent") @db.VarChar(500)
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz

  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User?         @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId], map: "idx_audit_logs_org_id")
  @@index([userId], map: "idx_audit_logs_user_id")
  @@index([createdAt], map: "idx_audit_logs_created_at")
  @@index([organizationId, id], map: "idx_audit_logs_org_composite")
  @@map("audit_logs")
}

/// Refresh tokens with family tracking for reuse detection and session revocation
model RefreshToken {
  id                  String    @id @default(uuid()) @map("id") @db.Uuid
  userId              String    @map("user_id") @db.Uuid
  tokenHash           String    @unique @map("token_hash") @db.VarChar(255)
  family              String    @map("family") @db.Uuid
  isRevoked           Boolean   @default(false) @map("is_revoked")
  replacedByTokenHash String?   @map("replaced_by_token_hash") @db.VarChar(255)
  expiresAt           DateTime  @map("expires_at") @db.Timestamptz
  userAgent           String?   @map("user_agent") @db.VarChar(500)
  ipAddress           String?   @map("ip_address") @db.VarChar(45)
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz

  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "idx_refresh_tokens_user_id")
  @@index([family], map: "idx_refresh_tokens_family")
  @@map("refresh_tokens")
}

/// Single-use hashed password reset tokens with expiry
model PasswordResetToken {
  id        String    @id @default(uuid()) @map("id") @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.VarChar(255)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz
  usedAt    DateTime? @map("used_at") @db.Timestamptz
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "idx_password_reset_user_id")
  @@map("password_reset_tokens")
}

/// Single-use hashed email verification tokens with expiry
model EmailVerificationToken {
  id        String    @id @default(uuid()) @map("id") @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.VarChar(255)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz
  usedAt    DateTime? @map("used_at") @db.Timestamptz
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "idx_email_verification_user_id")
  @@map("email_verification_tokens")
}

/// Gym Member represents a customer enrolled in a Gym Tenant
model Member {
  id                           String          @id @default(uuid()) @map("id") @db.Uuid
  organizationId               String          @map("organization_id") @db.Uuid
  branchId                     String          @map("branch_id") @db.Uuid
  userId                       String?         @map("user_id") @db.Uuid
  memberNumber                 String          @map("member_number") @db.VarChar(50)
  firstName                    String          @map("first_name") @db.VarChar(100)
  lastName                     String          @map("last_name") @db.VarChar(100)
  preferredName                String?         @map("preferred_name") @db.VarChar(100)
  gender                       Gender?         @map("gender")
  dateOfBirth                  DateTime?       @map("date_of_birth") @db.Date
  email                        String?         @map("email") @db.VarChar(255)
  phone                        String          @map("phone") @db.VarChar(50)
  addressLine1                 String?         @map("address_line_1") @db.VarChar(255)
  addressLine2                 String?         @map("address_line_2") @db.VarChar(255)
  city                         String?         @map("city") @db.VarChar(100)
  state                        String?         @map("state") @db.VarChar(100)
  country                      String?         @map("country") @db.VarChar(100)
  postalCode                   String?         @map("postal_code") @db.VarChar(20)
  emergencyContactName         String?         @map("emergency_contact_name") @db.VarChar(100)
  emergencyContactPhone        String?         @map("emergency_contact_phone") @db.VarChar(50)
  emergencyContactRelationship String?         @map("emergency_contact_relationship") @db.VarChar(50)
  profilePhotoKey              String?         @map("profile_photo_key") @db.VarChar(500)
  notes                        String?         @map("notes") @db.Text
  status                       MemberStatus    @default(ACTIVE) @map("status")
  joinedAt                     DateTime        @default(now()) @map("joined_at") @db.Timestamptz
  createdAt                    DateTime        @default(now()) @map("created_at") @db.Timestamptz
  updatedAt                    DateTime        @updatedAt @map("updated_at") @db.Timestamptz
  createdBy                    String?         @map("created_by") @db.Uuid
  updatedBy                    String?         @map("updated_by") @db.Uuid
  archivedAt                   DateTime?       @map("archived_at") @db.Timestamptz

  // Relations
  organization                 Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch                       Branch          @relation(fields: [branchId], references: [id], onDelete: Restrict)
  user                         User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  transfers                    MemberTransfer[]
  memberships                  MemberMembership[]

  @@unique([organizationId, memberNumber], name: "unique_org_member_number")
  @@index([organizationId], map: "idx_members_org_id")
  @@index([branchId], map: "idx_members_branch_id")
  @@index([status], map: "idx_members_status")
  @@index([phone], map: "idx_members_phone")
  @@index([email], map: "idx_members_email")
  @@index([organizationId, id], map: "idx_members_org_composite")
  @@map("members")
}

/// MemberTransfer tracks branch transfer history for members
model MemberTransfer {
  id                  String        @id @default(uuid()) @map("id") @db.Uuid
  organizationId      String        @map("organization_id") @db.Uuid
  memberId            String        @map("member_id") @db.Uuid
  sourceBranchId      String        @map("source_branch_id") @db.Uuid
  destinationBranchId String        @map("destination_branch_id") @db.Uuid
  transferredBy       String        @map("transferred_by") @db.Uuid
  transferredAt       DateTime      @default(now()) @map("transferred_at") @db.Timestamptz
  reason              String?       @map("reason") @db.VarChar(255)

  // Relations
  organization        Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  member              Member        @relation(fields: [memberId], references: [id], onDelete: Cascade)
  sourceBranch        Branch        @relation("TransferFromBranch", fields: [sourceBranchId], references: [id], onDelete: Restrict)
  destinationBranch   Branch        @relation("TransferToBranch", fields: [destinationBranchId], references: [id], onDelete: Restrict)

  @@index([organizationId], map: "idx_member_transfers_org_id")
  @@index([memberId], map: "idx_member_transfers_member_id")
  @@index([organizationId, id], map: "idx_member_transfers_org_composite")
  @@map("member_transfers")
}

/// OrganizationMemberSequence tracks atomic concurrency-safe member number sequences
model OrganizationMemberSequence {
  organizationId      String        @id @map("organization_id") @db.Uuid
  currentValue        Int           @default(0) @map("current_value")
  updatedAt           DateTime      @updatedAt @map("updated_at") @db.Timestamptz

  organization        Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("organization_member_sequences")
}

/// MembershipPlan defines membership packages and passes offered by an organization
model MembershipPlan {
  id                    String            @id @default(uuid()) @map("id") @db.Uuid
  organizationId        String            @map("organization_id") @db.Uuid
  name                  String            @map("name") @db.VarChar(150)
  code                  String            @map("code") @db.VarChar(50)
  description           String?           @map("description") @db.VarChar(1000)

  // Duration & Pricing
  durationType          PlanDurationType  @default(MONTHS) @map("duration_type")
  durationValue         Int               @map("duration_value")
  price                 Decimal           @map("price") @db.Decimal(10, 2)
  registrationFee       Decimal           @default(0.00) @map("registration_fee") @db.Decimal(10, 2)
  currency              String            @default("INR") @map("currency") @db.VarChar(10)

  // Scope & Policies
  scope                 PlanScope         @default(SINGLE_BRANCH) @map("scope")
  maxFreezeDays         Int               @default(0) @map("max_freeze_days")
  maxFreezes            Int               @default(0) @map("max_freezes")
  gracePeriodDays       Int               @default(0) @map("grace_period_days")

  // Perks / Features
  features              Json?             @default("[]") @map("features")

  status                PlanStatus        @default(ACTIVE) @map("status")
  createdAt             DateTime          @default(now()) @map("created_at") @db.Timestamptz
  updatedAt             DateTime          @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  organization          Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branchScopes          MembershipPlanBranch[]
  subscriptions         MemberMembership[]

  @@unique([organizationId, code], name: "unique_org_plan_code")
  @@index([organizationId], map: "idx_membership_plans_org")
  @@index([organizationId, status], map: "idx_membership_plans_org_status")
  @@map("membership_plans")
}

/// MembershipPlanBranch defines branch scoping for multi-branch membership plans
model MembershipPlanBranch {
  id                String          @id @default(uuid()) @map("id") @db.Uuid
  organizationId    String          @map("organization_id") @db.Uuid
  planId            String          @map("plan_id") @db.Uuid
  branchId          String          @map("branch_id") @db.Uuid
  createdAt         DateTime        @default(now()) @map("created_at") @db.Timestamptz

  organization      Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  plan              MembershipPlan  @relation(fields: [planId], references: [id], onDelete: Cascade)
  branch            Branch          @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([planId, branchId], name: "unique_plan_branch")
  @@index([organizationId, branchId], map: "idx_plan_branches_org_branch")
  @@map("membership_plan_branches")
}

/// MemberMembership is the active/historical subscription linking a Member to a MembershipPlan
model MemberMembership {
  id                    String            @id @default(uuid()) @map("id") @db.Uuid
  organizationId        String            @map("organization_id") @db.Uuid
  memberId              String            @map("member_id") @db.Uuid
  planId                String            @map("plan_id") @db.Uuid
  homeBranchId          String            @map("home_branch_id") @db.Uuid

  // Schedule & Boundaries
  startDate             DateTime          @map("start_date") @db.Date
  endDate               DateTime          @map("end_date") @db.Date
  originalEndDate       DateTime          @map("original_end_date") @db.Date

  // Purchase-time Pricing & Snapshot (Immutable historical snapshot)
  basePrice             Decimal           @map("base_price") @db.Decimal(10, 2)
  registrationFee       Decimal           @default(0.00) @map("registration_fee") @db.Decimal(10, 2)
  discountAmount        Decimal           @default(0.00) @map("discount_amount") @db.Decimal(10, 2)
  discountReason        String?           @map("discount_reason") @db.VarChar(255)
  taxAmount             Decimal           @default(0.00) @map("tax_amount") @db.Decimal(10, 2)
  taxRate               Decimal           @default(0.00) @map("tax_rate") @db.Decimal(5, 2)
  finalPrice            Decimal           @map("final_price") @db.Decimal(10, 2)
  currency              String            @default("INR") @map("currency") @db.VarChar(10)
  pricingSnapshot       Json              @map("pricing_snapshot")

  // Freeze Tracking
  totalFreezeDaysUsed   Int               @default(0) @map("total_freeze_days_used")
  freezeCount           Int               @default(0) @map("freeze_count")

  // Renewal & Chaining
  renewalCount          Int               @default(0) @map("renewal_count")
  previousMembershipId  String?           @map("previous_membership_id") @db.Uuid

  status                MembershipStatus  @default(ACTIVE) @map("status")
  autoRenew             Boolean           @default(false) @map("auto_renew")
  notes                 String?           @map("notes") @db.Text

  // Cancellation
  cancelledAt           DateTime?         @map("cancelled_at") @db.Timestamptz
  cancellationReason    String?           @map("cancellation_reason") @db.VarChar(255)
  cancelledBy           String?           @map("cancelled_by") @db.Uuid

  createdAt             DateTime          @default(now()) @map("created_at") @db.Timestamptz
  updatedAt             DateTime          @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  organization          Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  member                Member            @relation(fields: [memberId], references: [id], onDelete: Cascade)
  plan                  MembershipPlan    @relation(fields: [planId], references: [id], onDelete: Restrict)
  homeBranch            Branch            @relation(fields: [homeBranchId], references: [id], onDelete: Restrict)
  freezes               MembershipFreeze[]
  history               MembershipHistory[]

  @@index([organizationId], map: "idx_member_memberships_org")
  @@index([organizationId, memberId], map: "idx_member_memberships_member")
  @@index([organizationId, status], map: "idx_member_memberships_status")
  @@index([organizationId, endDate], map: "idx_member_memberships_end_date")
  @@index([organizationId, homeBranchId], map: "idx_member_memberships_branch")
  @@map("member_memberships")
}

/// MembershipFreeze records individual freeze / pause requests
model MembershipFreeze {
  id                    String            @id @default(uuid()) @map("id") @db.Uuid
  organizationId        String            @map("organization_id") @db.Uuid
  membershipId          String            @map("membership_id") @db.Uuid

  startDate             DateTime          @map("start_date") @db.Date
  endDate               DateTime?         @map("end_date") @db.Date
  actualThawDate        DateTime?         @map("actual_thaw_date") @db.Date
  daysFrozen            Int               @default(0) @map("days_frozen")

  reason                String?           @map("reason") @db.VarChar(255)
  status                FreezeStatus      @default(ACTIVE) @map("status")

  frozenBy              String            @map("frozen_by") @db.Uuid
  thawedBy              String?           @map("thawed_by") @db.Uuid

  createdAt             DateTime          @default(now()) @map("created_at") @db.Timestamptz
  updatedAt             DateTime          @updatedAt @map("updated_at") @db.Timestamptz

  organization          Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  membership            MemberMembership  @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@index([organizationId], map: "idx_membership_freezes_org")
  @@index([membershipId], map: "idx_membership_freezes_membership")
  @@map("membership_freezes")
}

/// MembershipHistory provides an immutable append-only audit trail of subscription transitions
model MembershipHistory {
  id                    String            @id @default(uuid()) @map("id") @db.Uuid
  organizationId        String            @map("organization_id") @db.Uuid
  membershipId          String            @map("membership_id") @db.Uuid
  action                String            @map("action") @db.VarChar(50)
  actorId               String?           @map("actor_id") @db.Uuid
  previousState         Json?             @map("previous_state")
  newState              Json?             @map("new_state")
  reason                String?           @map("reason") @db.VarChar(255)
  timestamp             DateTime          @default(now()) @map("timestamp") @db.Timestamptz

  organization          Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  membership            MemberMembership  @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@index([organizationId, membershipId], map: "idx_membership_history_membership")
  @@map("membership_history")
}

/// MembershipOutboxEvent implements the Transactional Outbox Pattern for reliable automation event dispatch
model MembershipOutboxEvent {
  id                    String            @id @default(uuid()) @map("id") @db.Uuid
  organizationId        String            @map("organization_id") @db.Uuid
  aggregateId           String            @map("aggregate_id") @db.VarChar(100)
  eventType             String            @map("event_type") @db.VarChar(100)
  payload               Json              @map("payload")
  status                OutboxStatus      @default(PENDING) @map("status")
  retryCount            Int               @default(0) @map("retry_count")
  lastError             String?           @map("last_error") @db.Text
  processedAt           DateTime?         @map("processed_at") @db.Timestamptz
  idempotencyKey        String            @unique @map("idempotency_key") @db.VarChar(200)

  createdAt             DateTime          @default(now()) @map("created_at") @db.Timestamptz
  updatedAt             DateTime          @updatedAt @map("updated_at") @db.Timestamptz

  organization          Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, status], map: "idx_outbox_org_status")
  @@index([status, createdAt], map: "idx_outbox_status_created")
  @@map("membership_outbox_events")
}

