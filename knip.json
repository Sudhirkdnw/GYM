{
  "$schema": "https://unpkg.com/knip@5/overview/configuration-schema.json",
  "ignoreDependencies": [
    "eslint",
    "@typescript-eslint/eslint-plugin",
    "@typescript-eslint/parser",
    "@prisma/client",
    "argon2"
  ],
  "jest": false,
  "workspaces": {
    "apps/api": {
      "entry": ["src/main.ts", "src/**/*.spec.ts", "test/**/*.ts"],
      "project": ["src/**/*.ts", "test/**/*.ts"],
      "ignoreDependencies": [
        "@nestjs/jwt",
        "bullmq",
        "ioredis",
        "swagger-ui-express",
        "ts-jest",
        "@types/supertest",
        "rimraf",
        "supertest"
      ],
      "ignoreBinaries": ["eslint"],
      "jest": false
    },
    "apps/web": {
      "entry": ["src/app/**/*.{ts,tsx}"],
      "project": ["src/**/*.{ts,tsx}"],
      "ignoreDependencies": ["@gymos/config", "zod"]
    },
    "apps/worker": {
      "project": ["src/**/*.ts"],
      "ignoreDependencies": ["zod"]
    }
  }
}
