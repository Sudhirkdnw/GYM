{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "strict": true,
    "strictNullChecks": true,
    "strictFunctionTypes": true,
    "strictBindCallApply": true,
    "strictPropertyInitialization": true,
    "noImplicitAny": true,
    "noImplicitThis": true,
    "alwaysStrict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "baseUrl": ".",
    "paths": {
      "@gymos/shared-types": ["packages/shared-types/src/index.ts"],
      "@gymos/shared-types/*": ["packages/shared-types/src/*"],
      "@gymos/validation": ["packages/validation/src/index.ts"],
      "@gymos/validation/*": ["packages/validation/src/*"],
      "@gymos/config": ["packages/config/src/index.ts"],
      "@gymos/config/*": ["packages/config/src/*"]
    }
  }
}
